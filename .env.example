# FinSwitch Platform Environment Variables
# Copy this file to .env and update with your values

# Database
MONGO_PASSWORD=secureMongoPassword123
MONGO_URL=mongodb://admin:secureMongoPassword123@mongodb:27017/finswitch?authSource=admin

# Cache
REDIS_PASSWORD=secureRedisPassword123
REDIS_URL=redis://:secureRedisPassword123@redis:6379

# Security
JWT_SECRET=your-256-bit-secret-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Service URLs (internal Docker network)
USER_SERVICE_URL=http://user-service:3006
PAYMENT_SERVICE_URL=http://payment-service:3001
ROUTING_ENGINE_URL=http://routing-engine:3002
ISSUER_SIMULATOR_URL=http://issuer-simulator:3003
SETTLEMENT_SERVICE_URL=http://settlement-service:3004
RECONCILIATION_SERVICE_URL=http://reconciliation-service:3005

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Performance
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30000
RETRY_MAX_ATTEMPTS=3
CACHE_TTL=300

# Admin Portal
CORS_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4001
